<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>The Silent Stakeholder — {{ report.product }}</title>
<style>
  :root{--bg:#0d1117;--card:#161b22;--line:#30363d;--fg:#e6edf3;--mut:#8b949e;
        --ign:#f85149;--under:#d29922;--mis:#a371f7;--ok:#3fb950;--accent:#58a6ff}
  *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--fg);
    font:15px/1.5 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif}
  .wrap{max-width:960px;margin:0 auto;padding:32px 20px 80px}
  h1{font-size:26px;margin:0 0 4px} .sub{color:var(--mut);margin:0 0 24px}
  .headline{background:linear-gradient(135deg,#1f6feb22,#a371f722);border:1px solid var(--line);
    border-radius:12px;padding:18px 20px;margin:0 0 28px}
  .headline .k{color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:.08em}
  .headline .v{font-size:19px;font-weight:600;margin-top:6px}
  .gap{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin:0 0 18px}
  .gap h2{font-size:18px;margin:0 0 8px;display:flex;gap:10px;align-items:center}
  .rank{background:var(--accent);color:#0d1117;border-radius:999px;width:26px;height:26px;
    display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:14px}
  .verdict{font-size:11px;font-weight:700;padding:3px 8px;border-radius:6px;text-transform:uppercase;letter-spacing:.05em}
  .IGNORED{background:var(--ign)22;color:var(--ign);border:1px solid var(--ign)}
  .UNDER-PRIORITIZED{background:var(--under)22;color:var(--under);border:1px solid var(--under)}
  .MISUNDERSTOOD{background:var(--mis)22;color:var(--mis);border:1px solid var(--mis)}
  .conf{margin-left:auto;font-variant-numeric:tabular-nums;color:var(--mut)}
  .conf b{color:var(--fg);font-size:17px}
  .bar{height:6px;background:#21262d;border-radius:4px;overflow:hidden;margin:8px 0 12px}
  .bar>i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--ok))}
  .why{color:var(--fg)} .latent{color:var(--mut);font-style:italic;margin:8px 0}
  .feat{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
  .feat span{background:#21262d;border:1px solid var(--line);border-radius:6px;padding:2px 8px;font-size:12px;color:var(--mut)}
  .feat span b{color:var(--fg)}
  details{margin-top:10px;border-top:1px dashed var(--line);padding-top:10px}
  summary{cursor:pointer;color:var(--accent);font-size:13px}
  .ev{border-left:2px solid var(--line);padding:6px 0 6px 12px;margin:8px 0;font-size:13px}
  .ev .id{color:var(--mut);font-family:ui-monospace,Menlo,monospace;font-size:11px}
  .star{color:var(--under)} .react{color:var(--ok)}
  .val{margin-top:10px;font-size:13px;color:var(--mut)}
  .val b{color:var(--ok)}
  footer{color:var(--mut);font-size:12px;margin-top:30px;border-top:1px solid var(--line);padding-top:16px}
  code{background:#21262d;padding:1px 5px;border-radius:4px;font-size:12px}
  .stats{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 20px}
  .stat{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 14px;flex:1;min-width:120px}
  .stat .n{font-size:22px;font-weight:700} .stat .l{color:var(--mut);font-size:12px}
  .controls{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:0 0 20px}
  .chip{background:var(--card);border:1px solid var(--line);color:var(--fg);border-radius:999px;
    padding:6px 12px;font-size:13px;cursor:pointer;user-select:none}
  .chip.active{background:var(--accent);color:#0d1117;border-color:var(--accent);font-weight:600}
  #q{flex:1;min-width:180px;background:var(--card);border:1px solid var(--line);color:var(--fg);
    border-radius:8px;padding:8px 12px;font-size:13px}
  .gap.hidden{display:none} .empty{color:var(--mut);text-align:center;padding:30px}
</style>
</head>
<body><div class="wrap">
  <h1>🔇 The Silent Stakeholder</h1>
  <p class="sub">{{ report.product }} · roadmap snapshot T0 = {{ report.t0 }} · generated {{ report.generated_at.strftime('%Y-%m-%d %H:%M') }} · mode {{ report.meta.get('mode','?') }}</p>

  <div class="headline">
    <div class="k">The single most important unmet need</div>
    <div class="v">{{ report.one_sentence_gap }}</div>
  </div>

  <div class="stats">
    <div class="stat"><div class="n">{{ report.gaps|length }}</div><div class="l">ranked gaps</div></div>
    <div class="stat"><div class="n">{{ report.meta.get('n_signals','?') }}</div><div class="l">user signals</div></div>
    <div class="stat"><div class="n">{{ report.meta.get('n_themes','?') }}</div><div class="l">need themes</div></div>
    <div class="stat"><div class="n">{{ report.meta.get('n_roadmap','?') }}</div><div class="l">roadmap items</div></div>
    <div class="stat"><div class="n">{{ ((report.gaps|sum(attribute='confidence') / (report.gaps|length or 1))*100)|round|int }}%</div><div class="l">avg confidence</div></div>
  </div>

  <div class="controls">
    <span class="chip active" data-f="all">All</span>
    <span class="chip" data-f="IGNORED">Ignored</span>
    <span class="chip" data-f="UNDER-PRIORITIZED">Under-prioritized</span>
    <span class="chip" data-f="MISUNDERSTOOD">Misunderstood</span>
    <input id="q" type="search" placeholder="search needs & evidence…"/>
  </div>

  {% for g in report.gaps %}
  <div class="gap" data-verdict="{{ g.verdict }}">
    <h2><span class="rank">{{ g.rank }}</span> {{ g.need }}
        <span class="verdict {{ g.verdict }}">{{ g.verdict }}</span>
        <span class="conf">confidence <b>{{ (g.confidence*100)|round|int }}%</b></span></h2>
    <div class="bar"><i style="width:{{ (g.confidence*100)|round|int }}%"></i></div>
    <div class="why"><b>Why this is a gap:</b> {{ g.verdict_rationale }}</div>
    <div class="latent">Latent because: {{ g.latent_reasoning }}</div>
    <div class="feat">
      <span>volume <b>{{ g.confidence_breakdown.V }}</b></span>
      <span>diversity <b>{{ g.confidence_breakdown.D }}</b></span>
      <span>intensity <b>{{ g.confidence_breakdown.I }}</b></span>
      <span>cohesion <b>{{ g.confidence_breakdown.K }}</b></span>
      <span>gap-clarity <b>{{ g.confidence_breakdown.G }}</b></span>
      <span>contradiction <b>{{ g.confidence_breakdown.X }}</b></span>
    </div>
    {% if g.validation and g.validation.note %}
    <div class="val">🔮 <b>Backtest:</b> {{ g.validation.note }}{% if g.validation.lag_months is not none %} <b>(+{{ g.validation.lag_months }} months)</b>{% endif %}</div>
    {% endif %}
    <details><summary>Evidence trace — {{ g.evidence_signals|length }} signals</summary>
      {% for e in g.evidence_signals %}
      <div class="ev"><span class="id">{{ e.id }} · {{ e.source }}{% if e.date %} · {{ e.date }}{% endif %}</span>
        {% if e.star %}<span class="star">{{ '★' * e.star }}</span>{% endif %}
        {% if e.reactions %}<span class="react">👍{{ e.reactions }}</span>{% endif %}
        <div>{{ e.quote }}</div></div>
      {% endfor %}
      <div style="color:var(--mut);font-size:12px;margin-top:8px">Roadmap refs:
        {% for r in g.roadmap_refs %}<code>{{ r.id }}</code>{% if r.note %} ({{ r.note }}){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</div>
    </details>
    <details><summary>Adversarial check</summary><div class="latent">{{ g.adversarial_check }}</div></details>
  </div>
  {% endfor %}

  <footer>Every gap is provable from the linked signal IDs — no evidence, no gap.
  Confidence is a transparent linear model over the six features shown (see <code>SPEC.md §6</code>);
  calibration: {{ report.meta.get('calibration','?') }}.
  {{ report.meta.get('n_signals','?') }} signals · {{ report.meta.get('n_themes','?') }} themes · {{ report.meta.get('n_roadmap','?') }} roadmap items analysed.</footer>
</div>
<script>
(function(){
  var cards = Array.prototype.slice.call(document.querySelectorAll('.gap'));
  var chips = Array.prototype.slice.call(document.querySelectorAll('.chip'));
  var q = document.getElementById('q');
  var filter = 'all';
  function apply(){
    var term = (q.value || '').trim().toLowerCase();
    var shown = 0;
    cards.forEach(function(c){
      var okV = filter === 'all' || c.getAttribute('data-verdict') === filter;
      var okQ = !term || c.textContent.toLowerCase().indexOf(term) !== -1;
      var vis = okV && okQ;
      c.classList.toggle('hidden', !vis);
      if(vis) shown++;
    });
    var e = document.getElementById('empty');
    if(!shown && !e){ e=document.createElement('div'); e.id='empty'; e.className='empty';
      e.textContent='No gaps match this filter.'; q.parentNode.parentNode.appendChild(e); }
    else if(shown && e){ e.remove(); }
  }
  chips.forEach(function(ch){ ch.addEventListener('click', function(){
    chips.forEach(function(x){ x.classList.remove('active'); });
    ch.classList.add('active'); filter = ch.getAttribute('data-f'); apply();
  });});
  q.addEventListener('input', apply);
})();
</script>
</body></html>
