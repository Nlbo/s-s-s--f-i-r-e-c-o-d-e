# Copy to .env and fill in. .env is gitignored — NEVER commit real keys.

# --- LLM runtime. The system runs end-to-end WITHOUT any key via a deterministic
# local fallback (TF-IDF embeddings + rule-based extraction); quality is best with one set.
# Backend auto-detected in this priority: internal router (LLM_KEY) -> OpenAI -> offline.

# Option A: Hackstudio internal LLM router (OpenAI-compatible). Add LLM_KEY to enable.
#   Verify it with: bash scripts/check_llm_key.sh
LLM_KEY=
LLM_URL=https://llm-router-qa.qa.us-west-2.aws.wfk8s.com
LLM_MODEL=claude-opus-4-8

# Option B: OpenAI directly (also enables high-quality embeddings).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- GitHub (roadmap ingestion). A token lifts the rate limit 60 -> 5000 req/h. ---
# Use a fine-grained token with PUBLIC read-only scope. Read-only is enough for analysis;
# creating "digital stakeholder" issues (optional feature) needs issues:write on YOUR repo only.
GITHUB_TOKEN=

# --- Target product (defaults chosen by analysis; override to retarget the whole system) ---
TARGET_APP_PACKAGE=org.wordpress.android
TARGET_GITHUB_REPO=wordpress-mobile/WordPress-Android

# --- Temporal design: reviews are historical; T0 = roadmap snapshot cutoff for backtest ---
ANALYSIS_T0=2017-01-01

# --- Budgets (cost guardrails) ---
MAX_SIGNALS=6000
LLM_MAX_CONCURRENCY=8
