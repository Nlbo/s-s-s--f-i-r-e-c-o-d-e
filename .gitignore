# --- Secrets & env (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.secrets/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- Data caches (large / regenerable). Keep committed fixtures under tests/fixtures ---
data/raw/
data/cache/
data/interim/
*.parquet
!tests/fixtures/**/*.parquet

# --- LLM call cache ---
.llm_cache/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.log

# --- Outputs (regenerable; keep a sample in docs/) ---
out/

# Office temp/lock files
~$*
*.pdf
